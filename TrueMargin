lg_ppg_baseline = 22.0
lg_ypp_baseline = 5.3

def calculate_projection(team, opponent, is_home):
    t_data = db[team]
    opp_data = db[opponent]
    
    # 1. Base Ratings Relative to League Averages
    raw_off_rating = t_data["ema_off_ppg"] - lg_ppg_baseline
    raw_def_rating = lg_ppg_baseline - t_data["ema_def_ppg_allowed"]
    
    ypp_off_diff = (t_data["ema_off_ypp"] * weather_multiplier) - lg_ypp_baseline
    ypp_def_diff = lg_ypp_baseline - t_data["ema_def_ypp_allowed"]
    
    # 2. Opponent Rigor Adjustments
    adj_off = ((raw_off_rating * 0.3) + (ypp_off_diff * 15.5 * 0.7)) - (opp_data["opp_def_rigor_ppg"] - lg_ppg_baseline)
    adj_def = ((raw_def_rating * 0.3) + (ypp_def_diff * 15.5 * 0.7)) - (lg_ppg_baseline - opp_data["opp_off_rigor_ppg"])
    
    # 3. Compile Master Score Formula components
    proj_score = lg_ppg_baseline + adj_off + t_data["st_ema_epa"]
    if is_home:
        proj_score += hfa_weight
        
    return np.round(proj_score, 1)

